# Flask Environment
FLASK_ENV=development
FLASK_APP=backend/app.py
PORT=5000
SECRET_KEY=quantum-voting-super-secret-key-32-chars-minimum

# Database Configuration (PostgreSQL per approved Phase 0 architecture)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/quantum_evoting_db
# (Optional fallback for local offline testing if PostgreSQL service is unavailable: sqlite:///quantum_evoting.db)

# JWT Security
JWT_SECRET_KEY=quantum-jwt-signing-key-high-entropy-64-character-string-for-security-assurance
JWT_EXPIRATION_SECONDS=7200

# Quantum Simulation Parameters
BB84_DEFAULT_QUBIT_COUNT=128
BB84_QBER_THRESHOLD=0.11
SIMULATE_EAVESDROPPING=false

# Client Origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ==============================================================================
# Phase 17A — OTP Delivery Configuration
# ==============================================================================
# Mode: 'demo' (outputs simulated SMS to terminal) or 'sms' (dispatches via provider)
OTP_DELIVERY_MODE=demo
SMS_PROVIDER=twilio

# Twilio Configuration (Required when OTP_DELIVERY_MODE=sms and SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=

# Fast2SMS Configuration (Alternative India SMS Gateway when SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=

# Generic HTTP SMS Gateway (Alternative when SMS_PROVIDER=generic)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
