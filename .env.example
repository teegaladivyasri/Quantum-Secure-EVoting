# Flask Environment
FLASK_ENV=development
FLASK_APP=backend/app.py
PORT=5000
SECRET_KEY=quantum-voting-super-secret-key-32-chars-minimum

# Database Configuration (PostgreSQL per approved Phase 0 architecture)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/quantum_evoting_db
# (Optional fallback for local offline testing if PostgreSQL service is unavailable: sqlite:///quantum_evoting.db)

# JWT Security
JWT_SECRET_KEY=quantum-jwt-signing-key-high-entropy-64-character-string-for-security-assurance
JWT_EXPIRATION_SECONDS=7200

# Quantum Simulation Parameters
BB84_DEFAULT_QUBIT_COUNT=128
BB84_QBER_THRESHOLD=0.11
SIMULATE_EAVESDROPPING=false

# Client Origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173
